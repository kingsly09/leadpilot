{
  "name": "leadpilot",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:api": "npm run dev -w @leadpilot/api",
    "db:migrate": "npm run db:migrate -w @leadpilot/api",
