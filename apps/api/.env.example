# Supabase project "leadpilot". Put your database password in the two lines below.
# App traffic goes through the transaction pooler (port 6543)...
DATABASE_URL="postgresql://postgres.szwoamncykgzdnuwnlbg:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# ...migrations use the session pooler (port 5432).
DIRECT_URL="postgresql://postgres.szwoamncykgzdnuwnlbg:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
# Used from Step 2 onward
OPENAI_API_KEY=""
REDIS_URL="redis://localhost:6379"

# Step 4: email sending (optional; without a key, approved emails go to a dev outbox)
RESEND_API_KEY=""
EMAIL_FROM="LeadPilot <onboarding@resend.dev>"
# Which LeadPilot user the MCP server acts as
MCP_USER_EMAIL="admin@leadpilot.test"
